# Copia este archivo como .env y rellena los valores (Neon → Connect).
# .env NO se sube a git; .env.example sí, como plantilla SIN SECRETOS: nunca pongas valores reales aquí.

# Conexión POOLED (el host contiene "-pooler"). La usa la app en runtime.
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Conexión DIRECTA (mismo host SIN "-pooler"). La usa el CLI de Prisma para migraciones.
DIRECT_URL="postgresql://USUARIO:CONTRASEÑA@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Better Auth: firma las cookies de sesión. Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET="cambia-esto-por-un-secreto-aleatorio-de-32-bytes"
# URL base de la app (en producción, la URL real)
BETTER_AUTH_URL="http://localhost:3000"

# Pre-consulta con IA (OPCIONAL, de pago). Vacío = cuestionario guiado gratuito.
# Para activarla: AI_PROVIDER="claude" y la key de console.anthropic.com → API Keys.
# Solo se usa en el servidor: nunca con prefijo NEXT_PUBLIC_.
AI_PROVIDER=""
ANTHROPIC_API_KEY=""
